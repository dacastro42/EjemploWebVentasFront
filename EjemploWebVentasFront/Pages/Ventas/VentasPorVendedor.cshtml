@page
@model VentasPorVendedorModel
@{
    ViewData["Title"] = "Mis ventas";
}

<h2>Mis ventas</h2>
<a href="/Account/Logout">Cerrar sesión</a>

<p>
    <a href="/Ventas/Create">+ Crear nueva venta</a>
</p>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <p style="color:red">@Model.ErrorMessage</p>
}
else if (Model.Ventas == null || Model.Ventas.Count == 0)
{
    <p>No hay ventas registradas para este vendedor.</p>
}
else
{
    @foreach (var v in Model.Ventas)
    {
        <div style="border:1px solid #ccc; padding:12px; margin-bottom:12px;">
            <div><b>Venta #:</b> @v.IdVentas</div>
            <div><b>Fecha:</b> @v.FechaVenta</div>
            <div><b>Total:</b> @v.TotalVenta</div>
            <div><b>IVA:</b> @v.Iva</div>

            <hr />
            <b>Detalles</b>

            <table border="1" cellpadding="6" style="border-collapse:collapse; width:100%; margin-top:8px;">
                <thead>
                    <tr>
                        <th>Carro</th>
                        <th>Cantidad</th>
                        <th>Precio Unit.</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in v.Detalles)
                    {
                        <tr>
                            <td>
                                @if (d.Carro != null)
                                {
                                    <span>@d.Carro.Marca @d.Carro.Modelo (@d.Carro.Anio)</span>
                                }
                                else
                                {
                                    <span>CarroId: @d.CarroId</span>
                                }
                            </td>
                            <td>@d.Cantidad</td>
                            <td>@d.PrecioUnitario</td>
                            <td>@d.Subtotal</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
